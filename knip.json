{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/app/**/{page,layout,template,error,loading,not-found,route,default,head,manifest,sitemap,robots,opengraph-image,twitter-image,icon,apple-icon}.{ts,tsx,js,jsx}",
        "src/app/**/{global-error,_app,_document}.{ts,tsx,js,jsx}",
        "src/app/sw.ts",
        "src/proxy.{ts,tsx,js,jsx}",
        "next.config.js",
        "postcss.config.js",
        "tailwind.config.js",
        "vitest.config.ts",
        "vitest.setup.ts",
        "server-wrapper.js",
        "scripts/**/*.{mjs,js,ts}",
        ".storybook/main.{ts,tsx,js,jsx}",
        ".storybook/preview.{ts,tsx,js,jsx}",
        ".storybook/**/*.test.ts",
        "src/**/*.test.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx,js,jsx}", "!src/**/*.d.ts"]
    },
    "packages/zephyrex": {
      "entry": [
        "src/**/*.stories.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "src/components/ui/**/*.{ts,tsx}",
        "src/components/api/**/*.{ts,tsx}",
        "src/components/{markdown,data-table,theme,dropzone}/**/*.{ts,tsx}",
        "src/lib/zephyrex/{index,types,hooks,client,createMiddleware}.ts",
        "src/lib/zephyrex/extensions/index.ts",
        "src/lib/zephyrex/extensions/*/index.ts",
        "src/lib/zephyrex/pages/*/index.ts",
        "src/lib/api/index.ts",
        "src/lib/utils.ts",
        "src/hooks/api/index.ts",
        "src/hooks/*.{ts,tsx}",
        "src/testing/index.ts"
      ],
      "project": ["src/**/*.{ts,tsx,js,jsx}", "!src/**/*.d.ts"],
      "ignore": ["src/components/appwrapper/**"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/**/*.stories.{ts,tsx}", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignoreDependencies": ["@tailwindcss/oxide-*", "lightningcss-*"],
  "ignoreBinaries": ["docker-compose"]
}
