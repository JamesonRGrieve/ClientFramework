{
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noRedeclare": "off",
        "noExplicitAny": "warn"
      },
      "complexity": {
        "noThisInStatic": "off",
        "useLiteralKeys": "off"
      },
      "style": {
        "useFilenamingConvention": {
          "level": "warn",
          "options": {
            "filenameCases": ["kebab-case", "camelCase", "PascalCase"],
            "strictCase": false,
            "requireAscii": true
          }
        }
      }
    }
  },
  "formatter": {
    "enabled": false
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  }
}
