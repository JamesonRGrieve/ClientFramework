{
  "name": "zephyrex",
  "version": "1.0.0-alpha.1",
  "description": "Zephyrex Framework Client — app shell, auth, extensions, and UI for Zephyrex servers.",
  "author": "Jameson R Grieve",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesonRGrieve/ClientFramework.git",
    "directory": "packages/zephyrex"
  },
  "bugs": {
    "url": "https://github.com/JamesonRGrieve/ClientFramework/issues"
  },
  "homepage": "http://jamesonrgrieve.github.io/ClientFramework",
  "keywords": [
    "react",
    "nextjs",
    "components"
  ],
  "scripts": {
    "compile": "node scripts/dist-swap.mjs clean && tsc -p tsconfig.compile.json --outDir dist.next && tsc-alias -p tsconfig.compile.json --outDir dist.next --resolve-full-paths && node scripts/finish-dist.mjs dist.next && node scripts/dist-swap.mjs swap",
    "verify:dist": "node scripts/verify-dist.mjs",
    "prepack": "pnpm compile && pnpm verify:dist",
    "storybook": "storybook dev -p 3001",
    "storybook-build": "storybook build",
    "storybook-run": "npx http-server storybook-static -p 3001",
    "storybook-deploy": "storybook build && gh-pages -d storybook-static",
    "storybook-test": "test-storybook --url http://localhost:3001"
  },
  "main": "./dist/lib/zephyrex/index.js",
  "types": "./dist/lib/zephyrex/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/zephyrex/index.d.ts",
      "default": "./dist/lib/zephyrex/index.js"
    },
    "./types": {
      "types": "./dist/lib/zephyrex/types.d.ts",
      "default": "./dist/lib/zephyrex/types.js"
    },
    "./hooks": {
      "types": "./dist/lib/zephyrex/hooks.d.ts",
      "default": "./dist/lib/zephyrex/hooks.js"
    },
    "./hooks/api": {
      "types": "./dist/hooks/api/index.d.ts",
      "default": "./dist/hooks/api/index.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./client": {
      "types": "./dist/lib/zephyrex/client.d.ts",
      "default": "./dist/lib/zephyrex/client.js"
    },
    "./middleware": {
      "types": "./dist/lib/zephyrex/createMiddleware.d.ts",
      "default": "./dist/lib/zephyrex/createMiddleware.js"
    },
    "./api": {
      "types": "./dist/lib/api/index.d.ts",
      "default": "./dist/lib/api/index.js"
    },
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "default": "./dist/lib/utils.js"
    },
    "./testing": {
      "types": "./dist/testing/TestWrapper.d.ts",
      "default": "./dist/testing/TestWrapper.js"
    },
    "./extensions": {
      "types": "./dist/lib/zephyrex/extensions/index.d.ts",
      "default": "./dist/lib/zephyrex/extensions/index.js"
    },
    "./extensions/*": {
      "types": "./dist/lib/zephyrex/extensions/*/index.d.ts",
      "default": "./dist/lib/zephyrex/extensions/*/index.js"
    },
    "./pages/*": {
      "types": "./dist/lib/zephyrex/pages/*/index.d.ts",
      "default": "./dist/lib/zephyrex/pages/*/index.js"
    },
    "./ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "default": "./dist/components/ui/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./styles.css": "./dist/styles/zephyrex.css",
    "./package.json": "./package.json"
  },
  "dependenciesMeta": {
    "@jgrieve/forms": {
      "injected": true
    },
    "@zephyrex/auth": {
      "injected": true
    }
  },
  "dependencies": {
    "@jgrieve/forms": "^0.0.1-alpha.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^9.2.4",
    "@zephyrex/auth": "^0.0.1-alpha.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookies-next": "^6.1.1",
    "input-otp": "^1.5.0",
    "javascript-time-ago": "^2.6.4",
    "katex": "^0.18.9",
    "lucide-react": "^1.49.0",
    "mermaid": "^12.0.0",
    "motion": "^13.4.6",
    "react-day-picker": "^10.0.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "next": "^16.2.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-coverage": "^3.0.2",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/nextjs": "^10.6.1",
    "@storybook/test-runner": "^0.24.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "msw": "^3.0.1",
    "msw-storybook-addon": "^3.0.3",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
