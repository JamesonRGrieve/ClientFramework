{
  "name": "@zephyrex/rooms",
  "version": "0.0.1-alpha.1",
  "description": "Zephyrex rooms client: live changes to a record for everyone who may see it, over server-sent events with a polling fallback.",
  "author": "Jameson R Grieve",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesonRGrieve/ClientFramework.git",
    "directory": "packages/rooms"
  },
  "bugs": {
    "url": "https://github.com/JamesonRGrieve/ClientFramework/issues"
  },
  "keywords": [
    "zephyrex",
    "rooms",
    "live",
    "server-sent-events",
    "react",
    "nextjs"
  ],
  "scripts": {
    "compile": "node ../../scripts/compile-package.mjs",
    "verify:dist": "node ../../scripts/verify-dist.mjs",
    "prepack": "pnpm compile && pnpm verify:dist"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "zephyrex": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "react": "^19.3.0",
    "vitest": "^5.0.2",
    "zephyrex": "workspace:^",
    "zod": "^4.6.5"
  }
}
