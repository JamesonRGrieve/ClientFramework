{
  "name": "zephyrex",
  "version": "1.0.0-alpha.1",
  "description": "Zephyrex Framework Client — app shell, auth, extensions, and UI for Zephyrex servers.",
  "author": "Jameson R Grieve",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesonRGrieve/ClientFramework.git"
  },
  "scripts": {
    "dev": "rimraf ./.next && next dev -p 1109",
    "basic": "rimraf ./.next && next dev -p 3000",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "precommit": "npx prettier --check . && pnpm check && pnpm test && pnpm test:security",
    "build": "rimraf ./.next && next build --webpack",
    "clean-build": "rimraf ./.next && rimraf ./node_modules && pnpm install && pnpm build && pnpm start",
    "compile": "rimraf ./dist && tsc -p tsconfig.compile.json && tsc-alias -p tsconfig.compile.json --resolve-full-paths && node scripts/finish-dist.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "prepack": "pnpm compile && pnpm verify:dist",
    "start": "next start -p 1109",
    "docker": "docker-compose down && docker-compose pull && docker-compose build && docker-compose up -d",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "prettier": "prettier .",
    "prettier-fix": "prettier --write .",
    "fix": "prettier --write . && eslint . --fix",
    "standalone:copy": "cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "standalone:run": "node ./.next/standalone/server.js",
    "standalone": "run-s build standalone:copy standalone:run",
    "storybook": "storybook dev -p 3001",
    "storybook-build": "storybook build",
    "storybook-run": "npx http-server storybook-static -p 3001",
    "storybook-deploy": "storybook build && gh-pages -d storybook-static",
    "storybook-test": "test-storybook --url http://localhost:3001",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run --config security/vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "lint:ratchet:update": "node scripts/lint-ratchet.mjs --update",
    "typecheck:ratchet": "node scripts/typecheck-ratchet.mjs",
    "typecheck:ratchet:update": "node scripts/typecheck-ratchet.mjs --update",
    "symmetry": "node scripts/coverage-symmetry.mjs",
    "symmetry:ratchet": "node scripts/symmetry-ratchet.mjs",
    "symmetry:ratchet:update": "node scripts/symmetry-ratchet.mjs --update",
    "js-coverage": "node scripts/js-coverage.mjs",
    "js-coverage:ratchet": "node scripts/js-coverage-ratchet.mjs",
    "js-coverage:ratchet:update": "node scripts/js-coverage-ratchet.mjs --update",
    "knip:ratchet": "node scripts/knip-ratchet.mjs",
    "knip:ratchet:update": "node scripts/knip-ratchet.mjs --update",
    "deps:ratchet": "node scripts/depcruise-ratchet.mjs",
    "deps:ratchet:update": "node scripts/depcruise-ratchet.mjs --update",
    "type-coverage": "type-coverage --strict --no-detail",
    "type-coverage:ratchet": "node scripts/type-coverage-ratchet.mjs",
    "type-coverage:ratchet:update": "node scripts/type-coverage-ratchet.mjs --update",
    "strict:ratchet": "node scripts/strict-ratchet.mjs",
    "strict:ratchet:update": "node scripts/strict-ratchet.mjs --update",
    "test:typecheck:ratchet": "node scripts/test-typecheck-ratchet.mjs",
    "test:typecheck:ratchet:update": "node scripts/test-typecheck-ratchet.mjs --update",
    "important:ratchet": "node scripts/important-ratchet.mjs",
    "important:ratchet:update": "node scripts/important-ratchet.mjs --update",
    "css:ratchet": "node scripts/css-ratchet.mjs",
    "css:ratchet:update": "node scripts/css-ratchet.mjs --update",
    "biome:ratchet": "node scripts/biome-ratchet.mjs",
    "biome:ratchet:update": "node scripts/biome-ratchet.mjs --update",
    "animation:coverage": "node scripts/animation-coverage.mjs",
    "animation:ratchet": "node scripts/animation-ratchet.mjs",
    "animation:ratchet:update": "node scripts/animation-ratchet.mjs --update",
    "theme:coverage": "node scripts/theme-coverage.mjs",
    "theme:ratchet": "node scripts/theme-ratchet.mjs",
    "theme:ratchet:update": "node scripts/theme-ratchet.mjs --update",
    "size-limit": "size-limit",
    "lockfile:validate": "node scripts/lockfile-validate.mjs",
    "check": "pnpm lockfile:validate && pnpm lint:ratchet && pnpm typecheck:ratchet && pnpm symmetry:ratchet && pnpm js-coverage:ratchet && pnpm knip:ratchet && pnpm deps:ratchet && pnpm type-coverage:ratchet && pnpm strict:ratchet && pnpm test:typecheck:ratchet && pnpm important:ratchet && pnpm css:ratchet && pnpm biome:ratchet && pnpm animation:ratchet && pnpm theme:ratchet"
  },
  "keywords": [
    "react",
    "nextjs",
    "components"
  ],
  "bugs": {
    "url": "https://github.com/JamesonRGrieve/ClientFramework/issues"
  },
  "homepage": "http://jamesonrgrieve.github.io/ClientFramework",
  "main": "./dist/lib/zephyrex/index.js",
  "types": "./dist/lib/zephyrex/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/zephyrex/index.d.ts",
      "default": "./dist/lib/zephyrex/index.js"
    },
    "./types": {
      "types": "./dist/lib/zephyrex/types.d.ts",
      "default": "./dist/lib/zephyrex/types.js"
    },
    "./hooks": {
      "types": "./dist/lib/zephyrex/hooks.d.ts",
      "default": "./dist/lib/zephyrex/hooks.js"
    },
    "./client": {
      "types": "./dist/lib/zephyrex/client.d.ts",
      "default": "./dist/lib/zephyrex/client.js"
    },
    "./extensions": {
      "types": "./dist/lib/zephyrex/extensions/index.d.ts",
      "default": "./dist/lib/zephyrex/extensions/index.js"
    },
    "./extensions/*": {
      "types": "./dist/lib/zephyrex/extensions/*/index.d.ts",
      "default": "./dist/lib/zephyrex/extensions/*/index.js"
    },
    "./pages/*": {
      "types": "./dist/lib/zephyrex/pages/*/index.d.ts",
      "default": "./dist/lib/zephyrex/pages/*/index.js"
    },
    "./ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "default": "./dist/components/ui/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./styles.css": "./dist/styles/zephyrex.css",
    "./package.json": "./package.json"
  },
  "_moduleAliases": {
    "@": "."
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-darwin-arm64": "4.3.3",
    "@tailwindcss/oxide-darwin-x64": "4.3.3",
    "@tailwindcss/oxide-linux-arm64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-arm64-musl": "4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.3",
    "@tailwindcss/oxide-win32-arm64-msvc": "4.3.3",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.3",
    "lightningcss-darwin-arm64": "1.33.0",
    "lightningcss-darwin-x64": "1.33.0",
    "lightningcss-linux-arm-gnueabihf": "1.33.0",
    "lightningcss-linux-arm64-gnu": "1.33.0",
    "lightningcss-linux-arm64-musl": "1.33.0",
    "lightningcss-linux-x64-gnu": "1.33.0",
    "lightningcss-linux-x64-musl": "1.33.0",
    "lightningcss-win32-arm64-msvc": "1.33.0",
    "lightningcss-win32-x64-msvc": "1.33.0"
  },
  "dependenciesMeta": {
    "@jgrieve/forms": {
      "injected": true
    },
    "@zephyrex/auth": {
      "injected": true
    }
  },
  "dependencies": {
    "@jgrieve/forms": "^0.0.1-alpha.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@serwist/next": "^9.5.12",
    "@tanstack/react-table": "^9.2.4",
    "@zephyrex/auth": "^0.0.1-alpha.1",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookies-next": "^6.1.1",
    "dotenv": "^18.0.4",
    "input-otp": "^1.5.0",
    "javascript-time-ago": "^2.6.4",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "mermaid": "^12.0.0",
    "motion": "^13.4.6",
    "npm-run-all": "^4.1.5",
    "react-day-picker": "^10.0.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.1.3",
    "serwist": "^9.5.12",
    "sharp": "^0.35.5",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "next": "^16.2.6",
