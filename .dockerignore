# Dependencies, at every level: each workspace package has its own node_modules, which would
# otherwise overwrite the image's freshly installed links at `COPY . .`.
**/node_modules
/.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
/tests
/coverage
test.ipynb

# Build output: the template's, and each package's dist (the image compiles its own)
/.next/
/out/
**/dist
**/dist.next
**/dist.old

# Version control
.git
.github
.gitignore

# Local environment files hold secrets; the image takes configuration at build (ARG) and run time.
.env
.env.*

# Storybook
.storybook
storybook-static

# Scripts
*.sh
merge-out.py
merge-out.json
merge-boilerplate.sh
launch_docker.sh

# Documentation
docs
*.md

# Temporary files
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
