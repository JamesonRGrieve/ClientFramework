{
  // What every extension package's tsconfig.compile.json extends: its src/ without tests, stories or
  // the mock servers they share (*.mocks.ts), emitted with declarations into its dist/
  // (compile-package.mjs passes dist.next/ as --outDir).
  "extends": "./tsconfig.package.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "allowJs": false,
    "incremental": false,
    "rootDir": "${configDir}/src",
    "outDir": "${configDir}/dist",
    "plugins": []
  },
  "include": ["${configDir}/src/**/*"],
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/dist",
    "${configDir}/src/**/*.test.ts",
    "${configDir}/src/**/*.test.tsx",
    "${configDir}/src/**/*.stories.ts",
    "${configDir}/src/**/*.stories.tsx",
    "${configDir}/src/**/*.mocks.ts"
  ]
}
