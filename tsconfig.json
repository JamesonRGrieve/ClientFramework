{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "next": [
        "./node_modules/next"
      ],
      "next/*": [
        "./node_modules/next/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@zephyrex/zod2gql": [
        "./src/lib/zod2gql/src"
      ],
      "@zephyrex/auth/*": [
        "./src/components/auth/src/*"
      ],
      "@jgrieve/appwrapper/*": [
        "./src/components/appwrapper/src/*"
      ],
      "@jgrieve/forms/*": [
        "./src/components/dynamic-form/src/*"
      ],
      "@/interactive/*": [
        "./src/interactive/src/*"
      ],
      "@/interface/*": [
        "./src/interface/*"
      ],
      "@/iteration/*": [
        "./src/iteration/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.js.old",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "app/theme.ts",
    "components/jrg/auth/auth.config.js",
    "components/interactive/interactive.config.js",
    "components/interactive/components/Chat/Activity/Severtities.tsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
